# Copy to .env and fill in what you need. Everything is optional.

# --- Core ---
# UPSC_DATA_DIR=./data
# UPSC_INBOX_DIR=./inbox
UPSC_FETCH_INTERVAL_MIN=15        # how often the live server pulls every source
# UPSC_CONCURRENCY=8
# UPSC_HTTP_TIMEOUT=20
# UPSC_KEEP_DAYS=400               # items older than this are pruned (library docs are kept)
# UPSC_HOST=127.0.0.1
# UPSC_PORT=8000

# --- Daily Brief ---
# UPSC_BRIEF_SIZE=25               # must-know stories per day
# UPSC_BRIEF_EDITORIALS=8          # editorials per day

# --- Videos: the closest-matching explainer for each brief story ---
# UPSC_VIDEO_LANG=en               # en = English only · hi = allow Hindi · any = all languages
# UPSC_VIDEO_SEARCH=1              # 0 = only match against the channel library, no YouTube search
# YOUTUBE_API_KEY=                 # optional: official YouTube Data API instead of the public search page

# --- Premium route 1: newsletters & e-paper emails over IMAP ---
# Gmail: turn on 2-step verification, create an App Password (myaccount.google.com/apppasswords),
# then create a Gmail label "UPSC" and a filter that puts every newsletter under it.
# IMAP_HOST=imap.gmail.com
# IMAP_USER=you@gmail.com
# IMAP_PASSWORD=your-16-char-app-password
# IMAP_FOLDER=UPSC                 # a Gmail label works as a folder; use INBOX to read everything
# IMAP_SENDERS=subscribe@indianexpressonline.in,newsletter@indianexpressonline.org
# IMAP_SINCE_DAYS=3

# --- Premium route 2: PDFs you download (Vision IAS / Drishti / ForumIAS magazines, e-paper PDFs) ---
# Just drop files into ./inbox — they are indexed automatically into the Library tab.

# --- Premium route 3: private feeds ---
# Copy config/sources.local.example.yaml to config/sources.local.yaml and add your URLs.

# --- Headless-browser fallback (for JS-heavy listing pages) ---
# UPSC_BROWSER_FALLBACK=1
# UPSC_BROWSER_EXECUTABLE=/path/to/chrome   # only if Playwright's bundled Chromium isn't installed

# --- AI explainers for the brief (What happened · Why in news · Background · Why it matters ·
#     Prelims facts · Mains question). Without a key you get a shorter auto-summary. ---
# ANTHROPIC_API_KEY=sk-ant-...
# UPSC_AI_MODEL=claude-opus-5          # server-side refusal fallback is on by default
# UPSC_AI_MAX_PER_RUN=40
